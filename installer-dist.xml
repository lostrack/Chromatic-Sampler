<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
<title>Chromatic Sampler</title>
<options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
<choices-outline>
<line choice="au"/><line choice="vst3"/><line choice="standalone"/>
</choices-outline>
<choice id="au" title="Audio Unit (Logic, GarageBand)"><pkg-ref id="com.selevenaudio.chromaticsampler.au"/></choice>
<choice id="vst3" title="VST3"><pkg-ref id="com.selevenaudio.chromaticsampler.vst3"/></choice>
<choice id="standalone" title="Standalone app"><pkg-ref id="com.selevenaudio.chromaticsampler.standalone"/></choice>
<pkg-ref id="com.selevenaudio.chromaticsampler.au">au.pkg</pkg-ref>
<pkg-ref id="com.selevenaudio.chromaticsampler.vst3">vst3.pkg</pkg-ref>
<pkg-ref id="com.selevenaudio.chromaticsampler.standalone">standalone.pkg</pkg-ref>
</installer-gui-script>
XML

productbuild --distribution "$P/dist.xml" --package-path "$P" "dist/Chromatic Sampler Installer.pkg"

mkdir -p "$P/dmg"; cp "dist/Chromatic Sampler Installer.pkg" "$P/dmg/"
hdiutil create -volname "Chromatic Sampler" -srcfolder "$P/dmg" -ov -format UDZO "dist/Chromatic-Sampler-1.0.0.dmg"

- uses: actions/upload-artifact@v4
with:
name: ChromaticSampler-macOS
